# YouTube Comment Triage Agent Environment Variables
# Copy to .env and configure with your keys

# --- APP CONFIGURATION ---
APP_ENV=development
LOG_LEVEL=INFO
SHADOW_MODE=true
AUTO_PUBLISH_ENABLED=false

# --- SECURITY ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_SECRET_KEY=y-GqU-s6N2uKk_k_H6FzV8D3n-E8M5e4b2d3Z1x9w8A=

# --- DATABASE ---
POSTGRES_USER=yt_agent
POSTGRES_PASSWORD=yt_agent_password
POSTGRES_DB=yt_triage
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://yt_agent:yt_agent_password@localhost:5432/yt_triage

# --- LLM PROVIDERS (FREE TIERS) ---
# Verify model IDs and rate limits in each provider console!
GROQ_API_KEY=your_groq_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- TOKEN BUDGET GUARD ---
DAILY_TOKEN_BUDGET=100000

# --- GOOGLE OAUTH 2.0 (YOUTUBE DATA API v3 - TESTING MODE) ---
# Create at https://console.cloud.google.com/ -> APIs & Services -> Credentials
# Testing Mode bypasses expensive Google verification audits!
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/youtube/callback

# --- CELERY / REDIS (OPTIONAL BACKGROUND SCALING) ---
REDIS_URL=redis://localhost:6379/0

